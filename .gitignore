.env

# AI & Documentation
ai-docs/
ai-docs-for-me/
AGENTS.md

# External third-party repos / datasets (cloned, not vendored)
external/

# Gurobi license (SECRET)
*.lic
gurobi.lic

# Large run logs / JSON outputs are not committed (use .md reports instead).
# Tracked historical files stay tracked; new ones must be forced with `git add -f`.
output/*.json
output/**/*.json

# Exception: compact, reviewable artifacts produced by
# scripts/compact_equiva_output.py (equiceval + baseline, per run).
!output/public/
!output/public/*.json
